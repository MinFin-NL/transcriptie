# Kopieer naar .env.local voor lokaal draaien. De backend leest dit bestand zelf;
# in Azure komen deze waarden uit de variable group `transcriptie-secrets`.

# ── Transcriptiedienst ─────────────────────────────────────────────────────────
# Lokaal: Voxtral Small 24B in Ollama (dit zijn ook de standaardwaarden als je
# niets invult). In productie: vlam-api van vlam.ai, met URL en sleutel uit de
# secrets.
TRANSCRIBE_URL=http://localhost:11434/v1/audio/transcriptions
TRANSCRIBE_MODEL=hf.co/bartowski/mistralai_Voxtral-Small-24B-2507-GGUF:Q4_K_M
# Leeg voor Ollama.
TRANSCRIBE_API_KEY=
# "Authorization" stuurt "Bearer <sleutel>"; een andere naam (bijv. api-key)
# stuurt de sleutel zoals hij is.
TRANSCRIBE_API_KEY_HEADER=Authorization
TRANSCRIBE_LANGUAGE=nl
# vlam-api (OpenAI-formaat): TRANSCRIBE_MODEL=vlam-transcribe-prepaid

# ── Sprekerherkenning ──────────────────────────────────────────────────────────
# local:   pyannote in de backend herkent de sprekers, daarna gaat elke beurt
#          naar de transcriptiedienst. Voor Ollama/Voxtral, dat zelf geen
#          sprekers levert. (standaard)
# service: de transcriptiedienst doet het zelf (vlam-api, diarized_json).
# off:     geen sprekerherkenning; de schakelaar verdwijnt uit de app.
DIARIZATION=local
# Het model staat achter een gebruikersovereenkomst op Hugging Face. Accepteer
# die één keer op huggingface.co/pyannote/speaker-diarization-community-1 en
# log in met `uv run hf auth login`, of zet hier een (lees)sleutel. Na de
# eerste download staat het model in de cache en is geen sleutel meer nodig.
HF_TOKEN=
# Model, of een map waarin je het model zelf hebt gezet.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Met DIARIZATION=service gaat de hele opname in één aanvraag (anders krijgt
# elk stuk eigen sprekerlabels). Alleen lager zetten als de dienst een grens heeft.
DIARIZE_CHUNK_SECONDS=7200
DIARIZE_TIMEOUT_SECONDS=3600

# ── Grenzen ────────────────────────────────────────────────────────────────────
MAX_AUDIO_SECONDS=7200
MAX_UPLOAD_MB=500
# Lengte van de stukken waarin lange opnames worden uitgeschreven.
CHUNK_SECONDS=600
# Hoe lang een klaar transcript op de server blijft (daarna gewist).
RESULT_TTL_SECONDS=3600

# ── Frontend (komt in de bundel terecht, dus nooit iets geheims) ───────────────
VITE_TRANSCRIBE_LANGUAGE=nl
VITE_MAX_AUDIO_MINUTES=120
VITE_MAX_UPLOAD_MB=500
