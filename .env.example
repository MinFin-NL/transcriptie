# Kopieer naar .env.local voor lokaal draaien. De backend leest dit bestand zelf;
# in Azure komen deze waarden uit de variable group `transcriptie-secrets`.

# ── Transcriptiedienst ─────────────────────────────────────────────────────────
# Lokaal: Voxtral Small 24B in Ollama (dit zijn ook de standaardwaarden als je
# niets invult). In productie: vlam-api van vlam.ai, met URL en sleutel uit de
# secrets; zie docs/vlam-ai.md.
TRANSCRIBE_URL=http://localhost:11434/v1/audio/transcriptions
TRANSCRIBE_MODEL=hf.co/bartowski/mistralai_Voxtral-Small-24B-2507-GGUF:Q4_K_M
# Leeg voor Ollama.
TRANSCRIBE_API_KEY=
# "Authorization" stuurt "Bearer <sleutel>"; een andere naam (bijv. api-key)
# stuurt de sleutel zoals hij is.
TRANSCRIBE_API_KEY_HEADER=Authorization
TRANSCRIBE_LANGUAGE=nl

# ── Grenzen ────────────────────────────────────────────────────────────────────
MAX_AUDIO_SECONDS=7200
MAX_UPLOAD_MB=500
# Lengte van de stukken waarin lange opnames worden uitgeschreven.
CHUNK_SECONDS=600
# Hoe lang een klaar transcript op de server blijft (daarna gewist).
RESULT_TTL_SECONDS=3600

# ── Frontend (komt in de bundel terecht, dus nooit iets geheims) ───────────────
VITE_TRANSCRIBE_LANGUAGE=nl
VITE_MAX_AUDIO_MINUTES=120
VITE_MAX_UPLOAD_MB=500
